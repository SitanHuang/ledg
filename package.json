{
  "name": "ledg",
  "version": "2.0.0-dev",
  "type": "module",
  "scripts": {
    "clean": "rimraf out/ types/ ~testout/ bin/",
    "lint": "eslint lib",
    "build": "tsc",
    "test": "vitest run --config lib/vitest.config.ts --coverage",
    "buildtest": "tsc && vitest run --config lib/vitest.config.ts --coverage",
    "run": "node out/cli/entry.js",
    "buildrun": "npm run build && node out/cli/entry.js",
    "esbuild": "esbuild --bundle lib/cli/entry.ts --minify --platform=node --outfile=./bin/ledg2.cjs --legal-comments=none --tree-shaking=true",
    "binary": "npm run buildtest && npm run esbuild"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "^3.1.3",
    "esbuild": "0.25.4",
    "eslint": "^9.24.0",
    "node-sloc": "^0.2.1",
    "rimraf": "^6.0.1",
    "tar": "^7.4.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.0",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "ansis": "^4.0.0",
    "chrono-node": "^2.8.0",
    "glob": "^11.0.2",
    "string-width": "^7.2.0",
    "supports-color": "^10.0.0"
  }
}
